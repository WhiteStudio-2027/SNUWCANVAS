#include <windows.h>
#include ".build/version.rc.h"
1 ICON "assets/app.ico"
1 RT_MANIFEST ".build/windows.manifest"
201 RCDATA "assets/splash.png"
202 RCDATA "assets/welcome-background.png"
203 RCDATA "assets/welcome-logo.png"
211 RCDATA "assets/fonts/NotoSansKR-Regular.ttf"
212 RCDATA "assets/fonts/NotoSansKR-Bold.ttf"
213 RCDATA "assets/fonts/GoogleSansCode-Regular.ttf"
221 RCDATA "assets/fonts/NotoSansKR-OFL.txt"
222 RCDATA "assets/fonts/GoogleSansCode-OFL.txt"
223 RCDATA "src/native/third_party/json-LICENSE.MIT"
1 VERSIONINFO
FILEVERSION SNUW_FILEVERSION
PRODUCTVERSION SNUW_FILEVERSION
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "SNUWCANVAS"
   VALUE "ProductName", "snuwcanvas"
   VALUE "FileVersion", SNUW_VERSION_STRING
   VALUE "ProductVersion", SNUW_DISPLAY_VERSION
   VALUE "OriginalFilename", "SNUWCANVAS.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
